# Copy to .env and fill in. Never commit real values.

# fixture = built-in demo data (shows a DEMO DATA banner); prestashop = live integration
COMMERCE_ADAPTER=fixture

# Public site origin used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3030

# PrestaShop origin (server-only). The Cloudflare rule must allow the BFF's egress IP.
PRESTASHOP_BASE_URL=https://hranitelnistoki.com
PRESTASHOP_WEBSERVICE_KEY=
PRESTASHOP_LANG_ID=2
PRESTASHOP_SHOP_ID=1

# Shared secret for HMAC-signed calls to the gnheadless PrestaShop module (server-only)
GNHEADLESS_HMAC_SECRET=

# Sessions
SESSION_SECRET=
SESSION_TTL_SECONDS=1209600

# Infrastructure (overridden by compose for in-network hosts)
REDIS_URL=redis://localhost:6379
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key-change-me-0123456789

# Web Push (VAPID). Generate with: docker compose run --rm app npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:gn_zaqvki@hranitelnistoki.com
